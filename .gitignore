.worktrees/
.superpowers/

# ROS/catkin generated workspaces
build/
devel/
build.bak_*/
devel.bak_*/
.catkin_tools/

# Python caches and local test output
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/

# Captured ROS console streams are local runtime artifacts. Curated Markdown
# runbooks and evidence summaries under logs/ remain versioned.
src/alicia_flexible_grasp_supervisor/logs/*.log

# Grasp bags, archive queue and local download validation (never Git history)
.grasp_records/
.grasp_archive_validation_*/
*.bag
*.bag.active

# Isolated native SDK runtime; binaries never enter Git history
.runtime/
