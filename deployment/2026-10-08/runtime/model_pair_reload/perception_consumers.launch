<launch>
  <arg name="mode" default="unknown"/>
  <arg name="strategy" default="observe_return"/>
  <!-- No YAML loads: preserve live speed, lift, mass, camera and safety policy. -->
  <node pkg="alicia_flexible_grasp_supervisor" type="perception_node.py" name="perception_node" output="screen">
    <remap from="/perception/object" to="/perception/carton/object"/>
    <remap from="/perception/object_mask" to="/perception/carton/object_mask"/>
    <remap from="/perception/object_pose_camera" to="/perception/carton/object_pose_camera"/>
    <remap from="/perception/object_pose_base" to="/perception/carton/object_pose_base"/>
    <remap from="/perception/object_detected" to="/perception/carton/object_detected"/>
    <remap from="/perception/raw_object_detected" to="/perception/carton/raw_object_detected"/>
    <remap from="/perception/detector_status" to="/perception/carton/detector_status"/>
  </node>
  <node pkg="alicia_grasp_modes" type="unknown_tabletop_perception.py" name="unknown_tabletop_perception" output="screen"/>
  <node pkg="alicia_grasp_modes" type="mode_aware_remote_grasp6d.py" name="remote_grasp6d_node" output="screen"/>
  <!-- Task is restarted through its existing dedicated systemd child unit. -->
  <node pkg="alicia_grasp_modes" type="mode_router.py" name="grasp_mode_router" output="screen">
    <param name="initial_mode" value="$(arg mode)"/>
    <param name="initial_strategy" value="$(arg strategy)"/>
  </node>
</launch>
